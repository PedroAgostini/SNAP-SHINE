# Snap Shine Clean — PRODUCTION: https://snapshineclean.com
# Apache 2.4 / compatible LiteSpeed (Hostinger).
Options -Indexes -MultiViews
DirectoryIndex index.html
# Missing pages show the branded 404 page (absolute asset paths, so it works at any depth).
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep internal project files private; preserve .well-known and ACME paths.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule \.(?:md|log|bak|sql|ini|env|cjs|ps1|zip)$ - [F,L,NC]
  RewriteRule ^antispam\.php$ - [F,L,NC]

  # One canonical address: https://snapshineclean.com (no www). No effect on localhost or other hosts.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTP_HOST} ^(?:www\.)?snapshineclean\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://snapshineclean.com%{REQUEST_URI} [R=301,L]

  # Redirect only client requests, never internal rewrites (avoids loops).
  RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?[?\s] [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,END]

  RewriteCond %{THE_REQUEST} \s/+(?:blog|clear-cache|privacy-policy|terms-of-use|redirect)\.html[?\s] [NC]
  RewriteRule ^(blog|clear-cache|privacy-policy|terms-of-use|redirect)\.html$ /$1 [R=301,END]

  RewriteRule ^(blog|clear-cache|privacy-policy|terms-of-use|redirect)/+$ /$1 [R=301,END]

  # Keep the HTML files on disk; expose extension-free page URLs.
  RewriteRule ^(blog|clear-cache|privacy-policy|terms-of-use|redirect)$ $1.html [END]

  # Removed with the post-construction service: every old address of that article goes to the blog.
  RewriteRule ^(?:blog/|artigos/)?post-construction-cleaning-bradenton(?:\.html|/+)?$ /blog [R=301,END]

  # Blog articles: artigos/<slug>.html is served at /blog/<slug>.
  # The folder is not named "blog" so DirectorySlash never fights the /blog/ -> /blog redirect.
  RewriteCond %{THE_REQUEST} \s/+artigos/[a-z0-9-]+(?:\.html)?[?\s] [NC]
  RewriteRule ^artigos/([a-z0-9-]+)(?:\.html)?$ /blog/$1 [R=301,END]
  RewriteRule ^blog/([a-z0-9-]+)(?:\.html|/+)$ /blog/$1 [R=301,END]
  RewriteRule ^blog/([a-z0-9-]+)$ artigos/$1.html [END]

  # Article addresses from the old WordPress site (/<slug>/) keep their links and ranking.
  RewriteRule ^(bradenton-office-deep-commercial-cleaning|maid-service-bradenton-fl-reclaim-your-weekend|bradenton-office-cleaning-schedule-guide|pet-owners-dust-free-home-bradenton-fl|diy-vs-pro-move-out-cleaning-bradenton-fl|house-cleaning-with-dogs-bradenton-fl|professional-deep-cleaning-bradenton-fl|house-cleaning-services-bradenton-fl-standard-clean)/?$ /blog/$1 [R=301,END]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages are always revalidated, so edits appear on the next visit.
  <FilesMatch "\.(?:html|xml|txt|webmanifest|vcf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS and JS are versioned with ?v=... in every page: bump it when they change.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Images keep their names when replaced, so they are cached for one week only.
  <FilesMatch "\.(?:webp|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <Files "clear-cache.html">
    # Browser cache for this origin only. No cookies, sessions or storage clearing.
    Header always set Clear-Site-Data "\"cache\""
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType text/plain .txt
  AddType text/vcard .vcf
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
